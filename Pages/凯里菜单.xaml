<Window x:Class="WindowUI.Pages.凯里菜单"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WindowUI.Pages"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="凯里菜单" Height="300" Width="500">
    <Grid>
        <Border BorderBrush="#FFF6F6F6" BorderThickness="5" CornerRadius="10,10,10,10" Margin="10"
                Background="#FFFEFEFE">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="请完善信息：" Margin="0,0,0,10" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="卡类型" VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="LuoHeCardType"
                        SelectionChanged="ComboBox_SelectionChanged"
                        MinWidth="300"
                        Margin="10,0,0,0"
                        SelectedIndex="0">
                        <ComboBoxItem Content="请选择卡类型" DataContext="" />
                        <ComboBoxItem Content="本地普通卡" DataContext="A1" />
                        <ComboBoxItem Content="学生卡" DataContext="A4" />
                        <ComboBoxItem Content="老年卡" DataContext="A5" />
                        <ComboBoxItem Content="军人卡" DataContext="B5" />
                        <ComboBoxItem Content="残疾人卡" DataContext="A6" />
                        <ComboBoxItem Content="互联互通普通卡" DataContext="01" />
                        <ComboBoxItem Content="见义勇为卡" DataContext="03" />
                        <ComboBoxItem Content="礼贤卡" DataContext="B7" />
                        <ComboBoxItem Content="外地残疾人卡" DataContext="A8" />
                        <ComboBoxItem Content="外地军人卡" DataContext="B4" />
                        <ComboBoxItem Content="外地老人卡" DataContext="A3" />
                        <ComboBoxItem Content="无偿献血卡" DataContext="02" />
                        <ComboBoxItem Content="员工卡" DataContext="B0" />
                    </ComboBox>
                </StackPanel>
                <ui:Button Content="确定" Width="100" Click="Button_Click" HorizontalAlignment="Center"
                           Background="#67C23A" MouseOverBackground="#A8E063" Foreground="White" Margin="0,30,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
